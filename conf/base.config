// Temel kaynak konfigürasyonu
// Proses başına CPU/bellek/süre limitleri

process {
    // NanoStat: hafif
    withName: 'NANOSTAT.*' {
        label        = 'process_low'
        cpus         = 4
        memory       = { 4.GB * task.attempt }
        time         = { 2.h * task.attempt }
        container    = 'quay.io/biocontainers/nanostat:1.6.0--pyhdfd78af_0'
    }

    // Chopper: orta
    withName: 'CHOPPER' {
        label        = 'process_medium'
        cpus         = 8
        memory       = { 8.GB * task.attempt }
        time         = { 4.h * task.attempt }
        container    = 'quay.io/biocontainers/chopper:0.7.0--hdcf5f25_0'
    }

    // Host removal: yüksek CPU
    withName: 'HOST_REMOVAL' {
        label        = 'process_high'
        cpus         = 16
        memory       = { 32.GB * task.attempt }
        time         = { 8.h * task.attempt }
        container    = 'ghcr.io/cinnetcrash/kanatli-host-removal:1.0'
    }

    // Kraken2: --memory-mapping sayesinde DB diskten okunur, 16GB RAM yeterli
    // Disk I/O'ya bağlı olarak yavaş olabilir — SSD tercih edilmeli
    withName: 'KRAKEN2' {
        label        = 'process_high_memory'
        cpus         = 8
        memory       = { 14.GB * task.attempt }
        time         = { 24.h * task.attempt }
        container    = 'staphb/kraken2:2.1.3'
    }

    // Bracken: hafif
    withName: 'BRACKEN' {
        label        = 'process_medium'
        cpus         = 4
        memory       = { 8.GB * task.attempt }
        time         = { 2.h * task.attempt }
        container    = 'staphb/bracken:2.9'
    }

    // İstatistiksel analiz
    withName: 'ABUNDANCE_ANALYSIS' {
        label        = 'process_medium'
        cpus         = 4
        memory       = { 16.GB * task.attempt }
        time         = { 4.h * task.attempt }
        container    = 'ghcr.io/cinnetcrash/kanatli-mikrobiyom-stats:1.0'
    }

    // MultiQC
    withName: 'MULTIQC' {
        label        = 'process_low'
        cpus         = 2
        memory       = { 4.GB * task.attempt }
        time         = { 1.h * task.attempt }
        container    = 'quay.io/biocontainers/multiqc:1.21--pyhdfd78af_0'
    }
}
