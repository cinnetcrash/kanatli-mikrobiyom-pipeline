// ─── Nextflow Konfigürasyon Dosyası ─────────────────────────────────────────

manifest {
    name        = 'kanatli-mikrobiyom-pipeline'
    description = 'Kanatlı mikrobiyom Nanopore analiz pipeline\'ı'
    version     = '1.0.0'
    author      = 'Mikrobiyom Araştırma Grubu'
    nextflowVersion = '>=23.04.0'
}

// ─── Varsayılan Parametreler ─────────────────────────────────────────────────
params {
    input              = null
    host_genome        = null
    kraken2_db         = null
    outdir             = 'results'
    min_quality        = 8
    min_length         = 500
    max_length         = 0
    bracken_readlen    = 150
    bracken_threshold  = 10
    kraken2_confidence = 0.0
    top_taxa           = 30
    threads            = 8
    // Proses başına max kaynak limitleri (16GB RAM sisteme göre ayarlandı)
    max_cpus           = 16
    max_memory         = '14.GB'
    max_time           = '72.h'
}

// ─── Profiller ───────────────────────────────────────────────────────────────
profiles {

    // Docker profili (önerilen)
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }

    // Singularity profili (HPC ortamları için)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    // Conda profili (alternatif)
    conda {
        conda.enabled          = true
        docker.enabled         = false
    }

    // Test profili - küçük veri seti ile
    test {
        params.input           = "${projectDir}/assets/samplesheet_test.csv"
        params.min_quality     = 7
        params.min_length      = 200
    }
}

// ─── Proses Ayarları ─────────────────────────────────────────────────────────
process {
    // Varsayılan kaynaklar
    cpus   = { check_max(params.threads,    'cpus')   }
    memory = { check_max(8.GB * task.attempt, 'memory') }
    time   = { check_max(4.h  * task.attempt, 'time')   }

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // Proses başına özel ayarlar
    withLabel: 'process_low' {
        cpus   = { check_max(4,    'cpus')   }
        memory = { check_max(4.GB * task.attempt, 'memory') }
    }
    withLabel: 'process_medium' {
        cpus   = { check_max(8,    'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
    }
    withLabel: 'process_high' {
        cpus   = { check_max(16,   'cpus')   }
        memory = { check_max(64.GB * task.attempt, 'memory') }
    }
    withLabel: 'process_high_memory' {
        cpus   = { check_max(8,    'cpus')   }
        memory = { check_max(128.GB * task.attempt, 'memory') }
        time   = { check_max(24.h  * task.attempt, 'time')   }
    }
}

// ─── Çıktı Ayarları ──────────────────────────────────────────────────────────
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}

// ─── Yardımcı Fonksiyonlar ────────────────────────────────────────────────────
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) }
        catch (all) { return obj }
    }
}
